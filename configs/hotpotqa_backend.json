{
  "cwd": ".",
  "timeout_s": 86400,
  "propose": [
    "{python}",
    "scripts/propose.py",
    "--request",
    "{request}",
    "--response",
    "{response}"
  ],
  "evaluate": [
    "{python}",
    "-m",
    "internalization.training.entrypoint",
    "evaluate",
    "--benchmark",
    "hotpotqa",
    "--env-config",
    "configs/hotpotqa.json",
    "--request",
    "{request}",
    "--response",
    "{response}"
  ],
  "train": [
    "{python}",
    "scripts/train.py",
    "--benchmark",
    "hotpotqa",
    "--env-config",
    "configs/hotpotqa.json",
    "--request",
    "{request}",
    "--response",
    "{response}"
  ],
  "benchmark": "hotpotqa",
  "execution": {
    "mode": "internalization"
  },
  "target": [
    "{python}",
    "-m",
    "internalization.training.entrypoint",
    "target",
    "--benchmark",
    "hotpotqa",
    "--env-config",
    "configs/hotpotqa.json",
    "--request",
    "{request}",
    "--response",
    "{response}"
  ],
  "check_internalization": [
    "{python}",
    "-m",
    "internalization.training.entrypoint",
    "check_internalization",
    "--benchmark",
    "hotpotqa",
    "--env-config",
    "configs/hotpotqa.json",
    "--request",
    "{request}",
    "--response",
    "{response}"
  ]
}
